<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="2dp"
        android:top="4dp"
        android:right="2dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#1A0B84FF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/white"
                android:startColor="#FFF8FBFF" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="#E8F2FF" />
        </shape>
    </item>
</layer-list>
