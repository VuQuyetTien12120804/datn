<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1E4FA3" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item
        android:bottom="8dp"
        android:left="8dp"
        android:right="8dp"
        android:top="8dp">
        <bitmap
            android:gravity="center"
            android:src="@drawable/ic_launcher_foreground_img" />
    </item>
</layer-list>
