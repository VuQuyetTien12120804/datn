<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="@color/doctor_brand_primary_dark"
                android:startColor="@color/doctor_brand_primary"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:gravity="top|end"
        android:top="-24dp"
        android:right="-24dp">
        <shape android:shape="oval">
            <size
                android:width="140dp"
                android:height="140dp" />
            <solid android:color="#22FFFFFF" />
        </shape>
    </item>
    <item
        android:gravity="bottom|start"
        android:bottom="-36dp"
        android:left="-20dp">
        <shape android:shape="oval">
            <size
                android:width="120dp"
                android:height="120dp" />
            <solid android:color="#18FFFFFF" />
        </shape>
    </item>
</layer-list>
