<?xml version="1.0" encoding="utf-8"?>
<!--
    Design tokens dùng chung cho toàn app.
    Muốn chỉnh cỡ chữ / khoảng cách / bo góc → chỉnh tại đây là tất cả layout bắt theo.
-->
<resources>

    <!-- ===== TEXT SIZES ===== -->
    <dimen name="text_caption">12sp</dimen>
    <dimen name="text_small">13sp</dimen>
    <dimen name="text_body">15sp</dimen>
    <dimen name="text_body_lg">16sp</dimen>
    <dimen name="text_subtitle">18sp</dimen>
    <dimen name="text_title">20sp</dimen>
    <dimen name="text_headline">22sp</dimen>
    <dimen name="text_display">26sp</dimen>

    <!-- ===== SPACING ===== -->
    <dimen name="space_xxs">2dp</dimen>
    <dimen name="space_xs">4dp</dimen>
    <dimen name="space_sm">8dp</dimen>
    <dimen name="space_md">12dp</dimen>
    <dimen name="space_lg">16dp</dimen>
    <dimen name="space_xl">20dp</dimen>
    <dimen name="space_xxl">24dp</dimen>

    <!-- ===== CORNER RADIUS ===== -->
    <dimen name="radius_sm">8dp</dimen>
    <dimen name="radius_md">12dp</dimen>
    <dimen name="radius_lg">16dp</dimen>
    <dimen name="radius_xl">22dp</dimen>
    <dimen name="radius_pill">28dp</dimen>

    <!-- ===== HOME TILE ===== -->
    <dimen name="tile_icon_size">60dp</dimen>
    <dimen name="tile_icon_text_size">28sp</dimen>
    <dimen name="tile_min_height">128dp</dimen>

    <!-- ===== SPECIALTY GRID ITEM ===== -->
    <dimen name="specialty_icon_size">54dp</dimen>
    <dimen name="specialty_icon_text_size">30sp</dimen>
    <dimen name="specialty_min_height">118dp</dimen>

    <!-- ===== HOME DOCTOR ROW ===== -->
    <dimen name="home_doctor_avatar_size">76dp</dimen>
    <dimen name="home_doctor_avatar_text_size">26sp</dimen>

    <!-- ===== BOTTOM NAVIGATION =====
         Muốn đổi to/nhỏ chỉ cần sửa 3 dim dưới đây, áp dụng cho cả Home
         (activity_main.xml) và Doctor panel (activity_doctor_main.xml). -->
    <dimen name="bottom_nav_icon_size">28dp</dimen>
    <dimen name="bottom_nav_label_size">14sp</dimen>
    <dimen name="bottom_nav_label_size_active">14sp</dimen>
    <dimen name="bottom_nav_min_height">75dp</dimen>

    <!-- ===== DOCTOR LIST CARD (màn danh bạ bác sĩ) ===== -->
    <!-- Avatar trong card danh sách bác sĩ to hơn home để nhìn rõ, giống tham chiếu YouMed. -->
    <dimen name="doctor_list_avatar_size">88dp</dimen>
    <dimen name="doctor_list_avatar_text_size">32sp</dimen>
    <dimen name="doctor_list_card_padding">20dp</dimen>
    <dimen name="doctor_list_card_gap">12dp</dimen>
    <dimen name="doctor_list_book_btn_padding">14dp</dimen>

    <!-- ===== HOME BANNER ===== -->
    <dimen name="banner_height">190dp</dimen>
    <dimen name="banner_dot_height">8dp</dimen>

    <!-- ===== HOME HEADER ===== -->
    <dimen name="home_header_avatar_size">40dp</dimen>
    <dimen name="home_header_avatar_text_size">18sp</dimen>
    <dimen name="home_search_radius">28dp</dimen>

    <!-- ===== HEADER TOOLBAR (YouMed-like) ===== -->
    <!-- Chỉnh 1 chỗ để áp cho mọi màn toolbar xanh (Tin nhắn/Lịch khám/Tư vấn/...) -->
    <dimen name="header_toolbar_height">60dp</dimen>
    <dimen name="header_toolbar_padding_horizontal">8dp</dimen>
    <!-- Tách khoảng dưới title so với mép dưới -->
    <dimen name="header_toolbar_padding_bottom">6dp</dimen>

</resources>
