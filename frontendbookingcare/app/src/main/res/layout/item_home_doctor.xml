<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_sm"
    android:paddingTop="@dimen/space_xs"
    android:paddingEnd="@dimen/space_sm"
    android:paddingBottom="@dimen/space_xs">

    <FrameLayout
        android:id="@+id/doctor_avatar_bg"
        android:layout_width="@dimen/home_doctor_avatar_size"
        android:layout_height="@dimen/home_doctor_avatar_size">

        <TextView
            android:id="@+id/doctor_avatar_letter"
            style="@style/Text.Doctor.AvatarLetter"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <TextView
        android:id="@+id/doctor_name"
        style="@style/Text.Doctor.Name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:maxLines="2"
        android:ellipsize="end" />
</LinearLayout>
