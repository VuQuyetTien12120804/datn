<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/doctor_fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/doctor_bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/doctor_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/bottom_nav_min_height"
        android:background="@color/doctor_nav_bg"
        android:elevation="10dp"
        app:elevation="10dp"
        app:itemIconTint="@color/doctor_bottom_nav_item"
        app:itemTextColor="@color/doctor_bottom_nav_item"
        app:itemIconSize="@dimen/bottom_nav_icon_size"
        app:itemTextAppearanceActive="@style/Text.BottomNav.Active"
        app:itemTextAppearanceInactive="@style/Text.BottomNav.Inactive"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/menu_doctor_bottom_nav" />
</androidx.constraintlayout.widget.ConstraintLayout>
