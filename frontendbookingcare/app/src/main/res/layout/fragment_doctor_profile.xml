<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_page_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header xanh brand -->
        <LinearLayout
            android:id="@+id/doctor_profile_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_home_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_lg"
            android:paddingTop="@dimen/space_xl"
            android:paddingEnd="@dimen/space_lg"
            android:paddingBottom="@dimen/space_xl">

            <FrameLayout
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:background="@drawable/bg_circle_white_trans">

                <TextView
                    android:id="@+id/doctor_profile_avatar_letter"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="👤"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_display" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/doctor_profile_name"
                    style="@style/Text.Home.UserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_headline" />

                <TextView
                    android:id="@+id/doctor_profile_title"
                    style="@style/Text.Home.Greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:id="@+id/doctor_profile_specialty_chip"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:background="@drawable/bg_circle_white_trans"
                    android:drawablePadding="@dimen/space_xs"
                    android:drawableStart="@android:drawable/ic_menu_info_details"
                    android:paddingStart="@dimen/space_md"
                    android:paddingTop="@dimen/space_xs"
                    android:paddingEnd="@dimen/space_md"
                    android:paddingBottom="@dimen/space_xs"
                    android:textColor="@color/white"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 4 stat cards 2x2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_marginTop="@dimen/space_md"
            android:layout_marginEnd="@dimen/space_sm"
            android:orientation="horizontal">

            <include
                android:id="@+id/stat_total"
                layout="@layout/item_doctor_profile_stat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/stat_today"
                layout="@layout/item_doctor_profile_stat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_marginEnd="@dimen/space_sm"
            android:orientation="horizontal">

            <include
                android:id="@+id/stat_pending"
                layout="@layout/item_doctor_profile_stat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/stat_rating"
                layout="@layout/item_doctor_profile_stat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Thông tin chuyên môn -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_marginTop="@dimen/space_md"
            android:layout_marginEnd="@dimen/space_md"
            app:cardCornerRadius="@dimen/radius_md"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <TextView
                    style="@style/Text.Screen.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="@dimen/space_sm"
                    android:drawableStart="@android:drawable/ic_menu_info_details"
                    android:text="@string/doctor_profile_section_expertise" />

                <include
                    android:id="@+id/row_specialty"
                    layout="@layout/item_doctor_profile_field"
                    android:layout_marginTop="@dimen/space_md" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="@dimen/space_sm"
                    android:background="@color/doctor_divider" />

                <include
                    android:id="@+id/row_degree"
                    layout="@layout/item_doctor_profile_field" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="@dimen/space_sm"
                    android:background="@color/doctor_divider" />

                <include
                    android:id="@+id/row_license"
                    layout="@layout/item_doctor_profile_field" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Thông tin liên hệ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_marginTop="@dimen/space_md"
            android:layout_marginEnd="@dimen/space_md"
            app:cardCornerRadius="@dimen/radius_md"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <TextView
                    style="@style/Text.Screen.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="@dimen/space_sm"
                    android:drawableStart="@android:drawable/ic_menu_call"
                    android:text="@string/doctor_profile_section_contact" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📧"
                        android:textSize="@dimen/text_body_lg" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/doctor_profile_field_email" />

                        <TextView
                            android:id="@+id/doctor_profile_email"
                            style="@style/Text.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="@dimen/space_md"
                    android:background="@color/doctor_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📞"
                        android:textSize="@dimen/text_body_lg" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/doctor_profile_field_phone" />

                        <TextView
                            android:id="@+id/doctor_profile_phone"
                            style="@style/Text.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Bảng xếp hạng -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_marginTop="@dimen/space_md"
            android:layout_marginEnd="@dimen/space_md"
            app:cardCornerRadius="@dimen/radius_md"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.Screen.Title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:drawablePadding="@dimen/space_sm"
                        android:drawableStart="@android:drawable/btn_star_big_on"
                        android:text="@string/doctor_profile_section_leaderboard" />

                    <TextView
                        android:id="@+id/doctor_profile_rank_chip"
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_doctor_priority_chip"
                        android:paddingStart="@dimen/space_md"
                        android:paddingTop="@dimen/space_xs"
                        android:paddingEnd="@dimen/space_md"
                        android:paddingBottom="@dimen/space_xs"
                        android:textColor="@color/doctor_priority_orange"
                        android:textStyle="bold" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/doctor_profile_period_tabs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_doctor_tab_inactive"
                        android:orientation="horizontal"
                        android:padding="@dimen/space_xxs" />
                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/doctor_profile_leaderboard_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/doctor_profile_logout"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_marginTop="@dimen/space_lg"
            android:layout_marginEnd="@dimen/space_md"
            android:layout_marginBottom="@dimen/space_xxl"
            android:background="@drawable/bg_doctor_logout_btn"
            android:drawablePadding="@dimen/space_sm"
            android:gravity="center"
            android:paddingTop="@dimen/space_md"
            android:paddingBottom="@dimen/space_md"
            android:text="@string/doctor_logout"
            android:textColor="@color/doctor_logout_red"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
