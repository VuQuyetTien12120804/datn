<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/doctor_surface_bg"
    android:orientation="vertical">

    <!-- Header cố định — không nằm trong vùng cuộn -->
    <LinearLayout
        android:id="@+id/doctor_profile_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_doctor_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_lg"
        android:paddingTop="@dimen/space_xl"
        android:paddingEnd="@dimen/space_lg"
        android:paddingBottom="@dimen/space_xl">

        <FrameLayout
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:background="@drawable/bg_circle_white_trans">

            <TextView
                android:id="@+id/doctor_profile_avatar_letter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="@dimen/text_display"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/doctor_profile_name"
                style="@style/Text.Home.UserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_headline" />

            <TextView
                android:id="@+id/doctor_profile_title"
                style="@style/Text.Home.Greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:textSize="@dimen/text_body" />

            <TextView
                android:id="@+id/doctor_profile_specialty_chip"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_circle_white_trans"
                android:drawablePadding="@dimen/space_xs"
                android:drawableTint="@color/white"
                android:drawableStart="@android:drawable/ic_menu_info_details"
                android:paddingStart="@dimen/space_md"
                android:paddingTop="@dimen/space_xs"
                android:paddingEnd="@dimen/space_md"
                android:paddingBottom="@dimen/space_xs"
                android:textColor="@color/white"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_md"
            android:paddingTop="10dp">

            <!-- Thống kê (chỉ số có nguồn API) — hơi chồng lên header cho chiều sâu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_marginTop="-5dp"
                android:layout_marginEnd="@dimen/space_sm"
                android:orientation="horizontal">

                <include
                    android:id="@+id/stat_today"
                    layout="@layout/item_doctor_profile_stat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/stat_pending"
                    layout="@layout/item_doctor_profile_stat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- Cài đặt: ngôn ngữ (giống tài khoản bệnh nhân) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginEnd="@dimen/space_md"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/radius_md"
                app:cardElevation="3dp"
                app:strokeColor="@color/doctor_stat_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingTop="@dimen/space_md"
                    android:paddingEnd="@dimen/space_lg"
                    android:paddingBottom="@dimen/space_md">

                    <TextView
                        style="@style/Text.Screen.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_sm"
                        android:text="@string/doctor_profile_section_settings" />

                    <include layout="@layout/item_doctor_language_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Thông tin chuyên môn -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginEnd="@dimen/space_md"
                app:cardCornerRadius="@dimen/radius_md"
                app:cardElevation="2dp"
                app:strokeColor="@color/doctor_stat_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <TextView
                        style="@style/Text.Screen.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="@dimen/space_sm"
                        android:drawableTint="@color/doctor_brand_primary"
                        android:drawableStart="@android:drawable/ic_menu_info_details"
                        android:text="@string/doctor_profile_section_expertise" />

                    <include
                        android:id="@+id/row_specialty"
                        layout="@layout/item_doctor_profile_field"
                        android:layout_marginTop="@dimen/space_md" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="@dimen/space_sm"
                        android:background="@color/doctor_divider" />

                    <include
                        android:id="@+id/row_degree"
                        layout="@layout/item_doctor_profile_field" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="@dimen/space_sm"
                        android:background="@color/doctor_divider" />

                    <include
                        android:id="@+id/row_license"
                        layout="@layout/item_doctor_profile_field" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Nơi công tác & lịch tiếp nhận -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginEnd="@dimen/space_md"
                app:cardCornerRadius="@dimen/radius_md"
                app:cardElevation="2dp"
                app:strokeColor="@color/doctor_stat_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <TextView
                        style="@style/Text.Screen.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="@dimen/space_sm"
                        android:drawableTint="@color/doctor_brand_primary"
                        android:drawableStart="@android:drawable/ic_menu_mylocation"
                        android:text="@string/doctor_profile_section_workplace" />

                    <include
                        android:id="@+id/row_room"
                        layout="@layout/item_doctor_profile_field"
                        android:layout_marginTop="@dimen/space_md" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="@dimen/space_sm"
                        android:background="@color/doctor_divider" />

                    <include
                        android:id="@+id/row_unit"
                        layout="@layout/item_doctor_profile_field" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="@dimen/space_sm"
                        android:background="@color/doctor_divider" />

                    <include
                        android:id="@+id/row_schedule"
                        layout="@layout/item_doctor_profile_field" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Thông tin liên hệ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginEnd="@dimen/space_md"
                app:cardCornerRadius="@dimen/radius_md"
                app:cardElevation="2dp"
                app:strokeColor="@color/doctor_stat_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <TextView
                        style="@style/Text.Screen.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="@dimen/space_sm"
                        android:drawableTint="@color/doctor_brand_primary"
                        android:drawableStart="@android:drawable/ic_menu_call"
                        android:text="@string/doctor_profile_section_contact" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_doctor_contact_icon">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:contentDescription="@string/doctor_profile_field_email"
                                android:src="@drawable/ic_doctor_email" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/doctor_profile_field_email" />

                            <TextView
                                android:id="@+id/doctor_profile_email"
                                style="@style/Text.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="@dimen/space_md"
                        android:background="@color/doctor_divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_doctor_contact_icon">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:contentDescription="@string/doctor_profile_field_phone"
                                android:src="@drawable/ic_doctor_phone" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/doctor_profile_field_phone" />

                            <TextView
                                android:id="@+id/doctor_profile_phone"
                                style="@style/Text.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/doctor_profile_logout"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_marginTop="@dimen/space_lg"
                android:layout_marginEnd="@dimen/space_md"
                android:layout_marginBottom="@dimen/space_xxl"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="48dp"
                android:text="@string/doctor_logout"
                android:textColor="@color/doctor_logout_red"
                app:strokeColor="@color/doctor_logout_red"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
