<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_page_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_lg"
        android:paddingTop="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg">

        <TextView
            style="@style/Text.Screen.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/doctor_requests_title" />

        <TextView
            android:id="@+id/doctor_req_subtitle"
            style="@style/Text.Body.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_md"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/space_md">

        <TextView
            android:id="@+id/doctor_tab_pending"
            style="@style/Text.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_xs"
            android:layout_weight="1"
            android:background="@drawable/bg_doctor_tab_active"
            android:gravity="center"
            android:paddingTop="@dimen/space_md"
            android:paddingBottom="@dimen/space_md"
            android:textColor="@color/doctor_current_card_stroke" />

        <TextView
            android:id="@+id/doctor_tab_accepted"
            style="@style/Text.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_xs"
            android:layout_weight="1"
            android:background="@drawable/bg_doctor_tab_inactive"
            android:gravity="center"
            android:paddingTop="@dimen/space_md"
            android:paddingBottom="@dimen/space_md"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/doctor_tab_rejected"
            style="@style/Text.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_xs"
            android:layout_weight="1"
            android:background="@drawable/bg_doctor_tab_inactive"
            android:gravity="center"
            android:paddingTop="@dimen/space_md"
            android:paddingBottom="@dimen/space_md"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/doctor_req_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="@dimen/space_sm"
        android:paddingBottom="@dimen/space_lg" />
</LinearLayout>
