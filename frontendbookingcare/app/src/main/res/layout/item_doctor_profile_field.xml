<?xml version="1.0" encoding="utf-8"?>
<!-- Nhãn wrap_content; giá trị weight=1 — nếu làm ngược lại, chuỗi giá trị dài sẽ chiếm hết
     chỗ khiến nhãn (weight) bị ép co về 0 và vỡ layout dọc từng ký tự. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/field_label"
        style="@style/Text.Body.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginEnd="@dimen/space_md"
        android:labelFor="@id/field_value" />

    <TextView
        android:id="@+id/field_value"
        style="@style/Text.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_weight="1"
        android:gravity="end"
        android:textAlignment="viewEnd"
        android:textStyle="bold" />
</LinearLayout>
