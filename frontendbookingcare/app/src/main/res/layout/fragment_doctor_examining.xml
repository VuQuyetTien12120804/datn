<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/doctor_surface_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_marginTop="@dimen/space_md"
            android:layout_marginEnd="@dimen/space_md"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/doctor_stat_card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:background="@drawable/bg_doctor_header_top_accent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_lg">

                    <TextView
                        style="@style/Text.Screen.Title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="-0.02"
                        android:text="@string/doctor_exam_title" />

                    <TextView
                        android:id="@+id/doctor_exam_status"
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_doctor_status_wait"
                        android:letterSpacing="0.02"
                        android:paddingStart="@dimen/space_md"
                        android:paddingTop="@dimen/space_xs"
                        android:paddingEnd="@dimen/space_md"
                        android:paddingBottom="@dimen/space_xs"
                        android:text="@string/doctor_exam_status_idle"
                        android:textAllCaps="true"
                        android:textColor="@color/doctor_status_wait_fg"
                        android:textSize="@dimen/text_small"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/doctor_exam_header_hint"
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingEnd="@dimen/space_lg"
                    android:paddingBottom="@dimen/space_md"
                    android:text="@string/doctor_exam_header_hint"
                    android:textColor="@color/text_secondary_dim" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/doctor_exam_overdue_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginEnd="@dimen/space_md"
            android:visibility="gone"
            app:cardBackgroundColor="@color/doctor_request_section_overdue_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/doctor_request_section_stroke_overdue"
            app:strokeWidth="1dp">

            <TextView
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/space_sm"
                android:padding="@dimen/space_md"
                android:text="@string/doctor_exam_overdue_banner"
                android:textColor="@color/doctor_reject_red"
                app:drawableStartCompat="@android:drawable/ic_dialog_alert"
                app:drawableTint="@color/doctor_reject_red" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/doctor_exam_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_marginTop="@dimen/space_sm"
                android:layout_marginEnd="@dimen/space_md"
                app:cardBackgroundColor="@color/doctor_tab_active_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/doctor_current_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <TextView
                        android:id="@+id/doctor_exam_appt_meta"
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary_dim"
                        tools:text="Mã lịch · #1024" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/doctor_exam_avatar"
                            style="@style/Text.Doctor.AvatarLetter"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:textSize="@dimen/text_headline" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/doctor_exam_patient"
                                style="@style/Text.Doctor.NameLarge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <TextView
                                android:id="@+id/doctor_exam_age_gender"
                                style="@style/Text.Body.Secondary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xxs" />

                            <TextView
                                android:id="@+id/doctor_exam_date"
                                style="@style/Text.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_sm"
                                android:textColor="@color/text_primary"
                                tools:text="T5 11/05/2026" />

                            <TextView
                                android:id="@+id/doctor_exam_time"
                                style="@style/Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:background="@drawable/bg_doctor_time_pill"
                                android:drawablePadding="@dimen/space_xs"
                                android:drawableStart="@android:drawable/ic_menu_recent_history"
                                android:paddingStart="@dimen/space_md"
                                android:paddingTop="@dimen/space_xs"
                                android:paddingEnd="@dimen/space_md"
                                android:paddingBottom="@dimen/space_xs"
                                android:textColor="@color/text_primary" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/space_md"
                        android:background="@color/doctor_divider" />

                    <TextView
                        android:id="@+id/doctor_exam_booking_reason"
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:drawablePadding="@dimen/space_sm"
                        android:drawableStart="@android:drawable/ic_menu_info_details"
                        android:visibility="gone"
                        tools:text="Lý do: Đau đầu"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/doctor_exam_phone"
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:drawablePadding="@dimen/space_sm"
                        android:drawableStart="@android:drawable/ic_menu_call" />

                    <TextView
                        android:id="@+id/doctor_exam_address"
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:drawablePadding="@dimen/space_sm"
                        android:drawableStart="@android:drawable/ic_menu_mylocation"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginEnd="@dimen/space_md"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/doctor_stat_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <TextView
                        style="@style/Text.Doctor.NameLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/doctor_exam_notes_title" />

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:text="@string/doctor_exam_notes_subtitle"
                        android:textColor="@color/text_secondary_dim" />

                    <EditText
                        android:id="@+id/doctor_exam_notes"
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="@dimen/space_md"
                        android:background="@drawable/bg_doctor_notes_field"
                        android:gravity="top|start"
                        android:hint="@string/doctor_exam_notes_hint"
                        android:inputType="textMultiLine"
                        android:padding="@dimen/space_md"
                        android:textColorHint="@color/text_muted" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/doctor_exam_start_btn"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="52dp"
                        android:text="@string/doctor_exam_start"
                        android:textColor="@color/white"
                        app:backgroundTint="@color/doctor_brand_primary"
                        app:cornerRadius="14dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/doctor_exam_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_xl"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@null"
                app:srcCompat="@android:drawable/ic_menu_today"
                app:tint="@color/doctor_brand_primary" />

            <TextView
                style="@style/Text.Doctor.NameLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:gravity="center"
                android:text="@string/doctor_exam_empty_title"
                android:textAlignment="center" />

            <TextView
                style="@style/Text.Body.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                android:text="@string/doctor_exam_empty_hint"
                android:textAlignment="center" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_xxl" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
