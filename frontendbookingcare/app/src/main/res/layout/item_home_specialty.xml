<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:minHeight="@dimen/specialty_min_height"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_md"
    android:paddingBottom="@dimen/space_md">

    <TextView
        android:id="@+id/specialty_icon"
        style="@style/Text.Specialty.Icon"
        android:layout_width="@dimen/specialty_icon_size"
        android:layout_height="@dimen/specialty_icon_size" />

    <TextView
        android:id="@+id/specialty_label"
        style="@style/Text.Specialty.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:paddingStart="@dimen/space_xs"
        android:paddingEnd="@dimen/space_xs" />
</LinearLayout>
