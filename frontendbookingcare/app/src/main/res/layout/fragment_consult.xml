<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/consult_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/home_page_bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/consult_toolbar"
        style="@style/Widget.Frontendbookingcare.HeaderToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_primary"
        app:title="Tư vấn"
        app:titleTextColor="@color/white"
        app:titleCentered="true" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="1dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/divider_line"
        app:cardBackgroundColor="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bạn cần hỗ trợ?"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Kết nối bác sĩ/CSKH để tư vấn dịch vụ và hỗ trợ đặt lịch."
                android:textColor="@color/text_secondary_dim"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/consult_btn_support"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/brand_primary"
                android:text="Nhắn tin với CSKH"
                android:textColor="@color/white"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:text="Cuộc trò chuyện gần đây"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:textSize="13sp"
        android:letterSpacing="0.04" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/consult_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:clipToPadding="false" />
</LinearLayout>
