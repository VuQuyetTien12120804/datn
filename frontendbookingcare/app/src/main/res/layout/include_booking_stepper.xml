<?xml version="1.0" encoding="utf-8"?>
<!--
    Stepper 3 bước dùng chung cho toàn bộ luồng đặt lịch khám.
    Activity gán state bằng code: setActiveStep(int) trong BookingStepperHelper.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/booking_stepper_dot_1"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:background="@drawable/bg_booking_step_active"
        android:gravity="center"
        android:text="1"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/booking_stepper_label_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="@string/booking_step1_label"
        android:textColor="@color/brand_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text=">"
        android:textColor="#D1D5DB"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/booking_stepper_dot_2"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:background="@drawable/bg_booking_step_inactive"
        android:gravity="center"
        android:text="2"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/booking_stepper_label_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="@string/booking_step2_label"
        android:textColor="@color/text_secondary_dim"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text=">"
        android:textColor="#D1D5DB"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/booking_stepper_dot_3"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:background="@drawable/bg_booking_step_inactive"
        android:gravity="center"
        android:text="3"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/booking_stepper_label_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="@string/booking_step3_label"
        android:textColor="@color/text_secondary_dim"
        android:textSize="12sp" />
</LinearLayout>
