<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".BookingCareApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Frontendbookingcare"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        tools:targetApi="31">
        <activity
            android:name=".onboarding.OnboardingActivity"
            android:exported="true"
            android:theme="@style/Theme.Frontendbookingcare.Onboarding">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.doctor_directory.DoctorListActivity"
            android:exported="false" />
        <activity
            android:name=".ui.doctor_directory.DoctorDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.home.SpecialtyListActivity"
            android:exported="false" />
        <activity
            android:name=".ui.doctor_panel.DoctorMainActivity"
            android:exported="false"
            android:theme="@style/Theme.Frontendbookingcare.Doctor"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.booking.BookingStep1Activity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.booking.CompleteProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.booking.BookingStep2Activity"
            android:exported="false" />
        <activity
            android:name=".ui.booking.BookingResultActivity"
            android:exported="false" />
        <activity
            android:name=".ui.legal.LegalDocumentActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.appointments.AppointmentTicketActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.notifications.NotificationsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.support.chat.CustomerCareChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
